{
  "id": "SC-04",
  "description": "Failure injection 2 — remediation fails, orchestrator escalates after max attempts",
  "alert": { "type": "HIGH_LATENCY", "service": "api-gateway", "severity": "P1", "message": "P99 latency exceeded 10000ms" },
  "inject_failures": ["REMEDIATION_FAILED"],
  "expect": {
    "final_status": "ESCALATED",
    "diagnosis": { "recommended_action": "rollback", "confidence_min": 0.80 },
    "tools_called": ["fetch_logs", "fetch_metrics", "correlate_findings", "propose_diagnosis", "execute_fix"],
    "events_must_include": ["AGENT_FAILED", "ESCALATED"],
    "escalated": true,
    "plan_versions": 1
  }
}
