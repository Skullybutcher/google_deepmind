{
  "hosting": {
    "public": "frontend/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "aegis-backend",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/api/events",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "X-Accel-Buffering", "value": "no" }
        ]
      }
    ]
  }
}
